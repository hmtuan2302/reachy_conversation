# Copy to .env (git-ignored). Never commit real keys.
ROBOT_HOST=192.168.1.50          # robot IP; use the IP, not mDNS, under WSL2
OPENAI_API_KEY=
HF_TOKEN=                        # Hugging Face token: speech-to-text, and the camera with VISION_PROVIDER=hf
DEEPSEEK_API_KEY=                # DeepSeek key; used by `reachy-demo agent`
LLM_MODEL=deepseek-chat          # or deepseek-v4-pro (stronger, slower)
LLM_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=                  # Gemini key; text-to-speech for `agent` and `speak`
TTS_PROVIDER=gemini              # gemini | vieneu (local VieNeu-TTS v3 Turbo, `uv sync --extra vieneu`, no key)
TTS_VOICE=Kore                   # vieneu: a preset name e.g. "Mai Anh"; empty = model default
TTS_MODEL=gemini-3.8-flash-tts
TTS_PLAYER=                      # empty = Windows ffplay.exe; "none" = save WAV only
CLONE_AUDIO=                     # vieneu test: "clone my voice" uses this WAV instead of the mic
SAVE_SPEECH=on                   # off = don't save each spoken answer to data/speech/
REALTIME_MODEL=
REALTIME_VOICE=
VISION_PROVIDER=hf               # camera vision model: hf (HF realtime server, HF_TOKEN) | deepseek (DEEPSEEK_API_KEY)
VISION_MODEL=                    # deepseek only; default deepseek-chat (deepseek-v4-pro can't see images)
VISION_BASE_URL=                 # deepseek only; default LLM_BASE_URL
GATE_THRESHOLD=0.5               # overwritten by `calibrate`
VAD_THRESHOLD=0.5
VAD_HANGOVER_MS=450
VAD_RMS=500                      # mic loudness that counts as talking (ducks playback); tune with scripts/mic_check.py
ONSET_DB=15
PERCEPTION_MAX_HZ=10
LOG_DIR=data/logs
LOG_LEVEL=INFO
RECORD_AUDIO=false
MEMORY=on                        # off = agent without memory
MEMORY_DB=data/memory.db         # SQLite file for memory
MEMORY_MODEL=deepseek-chat       # LLM for memory writes (keep it fast, non-reasoning)
CONTEXT_MAX_TOKENS=8000          # cap for each LLM request: system prompt + memory + tools + history (approx, chars/4)
MEMORY_MAX_TOKENS=600            # memory block share inside CONTEXT_MAX_TOKENS
EMBED=on                         # off = keyword-only memory search (and no push)
EMBED_MODEL=onnx-community/embeddinggemma-300m-ONNX   # HF repo or local folder; needs `uv sync --extra embed`
MEMORY_PUSH=on                   # add up to 3 related memories to each turn (needs EMBED=on)
CONTEXT_DEBUG=off                # on = print the memory block, related memories and tool results before each answer
