VAD_THRESHOLD=0.5
VAD_HANGOVER_MS=450
ONSET_DB=15
PERCEPTION_MAX_HZ=10
LOG_DIR=data/logs
LOG_LEVEL=INFO
RECORD_AUDIO=false
